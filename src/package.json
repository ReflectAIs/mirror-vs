{
	"name": "mirror-vs",
	"displayName": "%extension.displayName%",
	"description": "%extension.description%",
	"publisher": "DipeshMajithia",
	"version": "0.6.10",
	"icon": "assets/icons/icon.png",
	"galleryBanner": {
		"color": "#1a1a2e",
		"theme": "dark"
	},
	"engines": {
		"vscode": "^1.84.0",
		"node": "20.19.2"
	},
	"author": {
		"name": "Dipesh Majithia"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/ReflectAIs/mirror-vs"
	},
	"homepage": "https://github.com/ReflectAIs/mirror-vs#readme",
	"categories": [
		"AI",
		"Chat",
		"Programming Languages",
		"Education",
		"Snippets",
		"Testing"
	],
	"keywords": [
		"ai",
		"assistant",
		"copilot",
		"chat",
		"ollama",
		"deepseek",
		"autonomous",
		"agent",
		"coding",
		"mirror"
	],
	"activationEvents": [
		"onLanguage",
		"onStartupFinished"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "mirror-vs-ActivityBar",
					"title": "%views.activitybar.title%",
					"icon": "assets/icons/icon.svg"
				}
			]
		},
		"views": {
			"mirror-vs-ActivityBar": [
				{
					"type": "webview",
					"id": "mirror-vs.SidebarProvider",
					"name": "%views.sidebar.name%"
				}
			]
		},
		"commands": [
			{
				"command": "mirror-vs.plusButtonClicked",
				"title": "%command.newTask.title%",
				"icon": "$(edit)"
			},
			{
				"command": "mirror-vs.historyButtonClicked",
				"title": "%command.history.title%",
				"icon": "$(history)"
			},
			{
				"command": "mirror-vs.popoutButtonClicked",
				"title": "%command.openInEditor.title%",
				"icon": "$(link-external)"
			},
			{
				"command": "mirror-vs.settingsButtonClicked",
				"title": "%command.settings.title%",
				"icon": "$(settings-gear)"
			},
			{
				"command": "mirror-vs.openInNewTab",
				"title": "%command.openInNewTab.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "mirror-vs.explainCode",
				"title": "%command.explainCode.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "mirror-vs.fixCode",
				"title": "%command.fixCode.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "mirror-vs.improveCode",
				"title": "%command.improveCode.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "mirror-vs.addToContext",
				"title": "%command.addToContext.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "mirror-vs.generateTests",
				"title": "%command.generateTests.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "mirror-vs.refactorFunction",
				"title": "%command.refactorFunction.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "mirror-vs.newTask",
				"title": "%command.newTask.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "mirror-vs.terminalAddToContext",
				"title": "%command.terminal.addToContext.title%",
				"category": "Terminal"
			},
			{
				"command": "mirror-vs.terminalFixCommand",
				"title": "%command.terminal.fixCommand.title%",
				"category": "Terminal"
			},
			{
				"command": "mirror-vs.terminalExplainCommand",
				"title": "%command.terminal.explainCommand.title%",
				"category": "Terminal"
			},
			{
				"command": "mirror-vs.setCustomStoragePath",
				"title": "%command.setCustomStoragePath.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "mirror-vs.importSettings",
				"title": "%command.importSettings.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "mirror-vs.focusInput",
				"title": "%command.focusInput.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "mirror-vs.acceptInput",
				"title": "%command.acceptInput.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "mirror-vs.toggleAutoApprove",
				"title": "%command.toggleAutoApprove.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "mirror-vs.toggleAutonomousMode",
				"title": "%command.toggleAutonomousMode.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "mirror-vs.acceptReview",
				"title": "%command.acceptReview.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "mirror-vs.rejectReview",
				"title": "%command.rejectReview.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "mirror-vs.acceptAllReviews",
				"title": "%command.acceptAllReviews.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "mirror-vs.diffReview",
				"title": "%command.diffReview.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "mirror-vs.prevChange",
				"title": "%command.prevChange.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "mirror-vs.nextChange",
				"title": "%command.nextChange.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "mirror-vs.newTab",
				"title": "%command.newTab.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "mirror-vs.newSession",
				"title": "%command.newSession.title%",
				"category": "%configuration.title%"
			},
			{
				"command": "mirror-vs.closeTab",
				"title": "%command.closeTab.title%",
				"category": "%configuration.title%"
			}
		],
		"menus": {
			"editor/context": [
				{
					"submenu": "mirror-vs.contextMenu",
					"group": "1"
				}
			],
			"mirror-vs.contextMenu": [
				{
					"command": "mirror-vs.addToContext",
					"group": "1_actions@1"
				},
				{
					"command": "mirror-vs.explainCode",
					"group": "1_actions@2"
				},
				{
					"command": "mirror-vs.improveCode",
					"group": "1_actions@3"
				},
				{
					"command": "mirror-vs.generateTests",
					"group": "1_actions@4"
				},
				{
					"command": "mirror-vs.refactorFunction",
					"group": "1_actions@5"
				}
			],
			"terminal/context": [
				{
					"submenu": "mirror-vs.terminalMenu",
					"group": "2"
				}
			],
			"mirror-vs.terminalMenu": [
				{
					"command": "mirror-vs.terminalAddToContext",
					"group": "1_actions@1"
				},
				{
					"command": "mirror-vs.terminalFixCommand",
					"group": "1_actions@2"
				},
				{
					"command": "mirror-vs.terminalExplainCommand",
					"group": "1_actions@3"
				}
			]
		},
		"keybindings": [
			{
				"command": "mirror-vs.addToContext",
				"key": "cmd+k cmd+a",
				"mac": "cmd+k cmd+a",
				"win": "ctrl+k ctrl+a",
				"linux": "ctrl+k ctrl+a",
				"when": "editorTextFocus && editorHasSelection"
			},
			{
				"command": "mirror-vs.toggleAutoApprove",
				"key": "cmd+alt+a",
				"mac": "cmd+alt+a",
				"win": "ctrl+alt+a",
				"linux": "ctrl+alt+a"
			},
			{
				"command": "mirror-vs.newTab",
				"key": "ctrl+n",
				"mac": "cmd+n",
				"win": "ctrl+n",
				"linux": "ctrl+n",
				"when": "activeWebviewPanelId == 'mirror-vs.TabPanelProvider' || focusedView == 'mirror-vs.SidebarProvider'"
			},
			{
				"command": "mirror-vs.newSession",
				"key": "ctrl+shift+n",
				"mac": "cmd+shift+n",
				"win": "ctrl+shift+n",
				"linux": "ctrl+shift+n",
				"when": "activeWebviewPanelId == 'mirror-vs.TabPanelProvider' || focusedView == 'mirror-vs.SidebarProvider'"
			},
			{
				"command": "mirror-vs.closeTab",
				"key": "ctrl+w",
				"mac": "cmd+w",
				"win": "ctrl+w",
				"linux": "ctrl+w",
				"when": "activeWebviewPanelId == 'mirror-vs.TabPanelProvider' || focusedView == 'mirror-vs.SidebarProvider'"
			}
		],
		"submenus": [
			{
				"id": "mirror-vs.contextMenu",
				"label": "%views.contextMenu.label%"
			},
			{
				"id": "mirror-vs.terminalMenu",
				"label": "%views.terminalMenu.label%"
			}
		],
		"configuration": {
			"title": "%configuration.title%",
			"properties": {
				"mirror-vs.allowedCommands": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						"git log",
						"git diff",
						"git show"
					],
					"description": "%commands.allowedCommands.description%"
				},
				"mirror-vs.deniedCommands": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"description": "%commands.deniedCommands.description%"
				},
				"mirror-vs.commandExecutionTimeout": {
					"type": "number",
					"default": 0,
					"minimum": 0,
					"maximum": 600,
					"description": "%commands.commandExecutionTimeout.description%"
				},
				"mirror-vs.commandTimeoutAllowlist": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"description": "%commands.commandTimeoutAllowlist.description%"
				},
				"mirror-vs.preventCompletionWithOpenTodos": {
					"type": "boolean",
					"default": false,
					"description": "%commands.preventCompletionWithOpenTodos.description%"
				},
				"mirror-vs.vsCodeLmModelSelector": {
					"type": "object",
					"properties": {
						"vendor": {
							"type": "string",
							"description": "%settings.vsCodeLmModelSelector.vendor.description%"
						},
						"family": {
							"type": "string",
							"description": "%settings.vsCodeLmModelSelector.family.description%"
						}
					},
					"description": "%settings.vsCodeLmModelSelector.description%"
				},
				"mirror-vs.customStoragePath": {
					"type": "string",
					"default": "",
					"description": "%settings.customStoragePath.description%"
				},
				"mirror-vs.enableCodeActions": {
					"type": "boolean",
					"default": true,
					"description": "%settings.enableCodeActions.description%"
				},
				"mirror-vs.autoImportSettingsPath": {
					"type": "string",
					"default": "",
					"description": "%settings.autoImportSettingsPath.description%"
				},
				"mirror-vs.maximumIndexedFilesForFileSearch": {
					"type": "number",
					"default": 10000,
					"minimum": 5000,
					"maximum": 500000,
					"description": "%settings.maximumIndexedFilesForFileSearch.description%"
				},
				"mirror-vs.useAgentRules": {
					"type": "boolean",
					"default": true,
					"description": "%settings.useAgentRules.description%"
				},
				"mirror-vs.apiRequestTimeout": {
					"type": "number",
					"default": 600,
					"minimum": 0,
					"maximum": 3600,
					"description": "%settings.apiRequestTimeout.description%"
				},
				"mirror-vs.newTaskRequireTodos": {
					"type": "boolean",
					"default": false,
					"description": "%settings.newTaskRequireTodos.description%"
				},
				"mirror-vs.codeIndex.embeddingBatchSize": {
					"type": "number",
					"default": 60,
					"minimum": 1,
					"maximum": 200,
					"description": "%settings.codeIndex.embeddingBatchSize.description%"
				},
				"mirror-vs.debug": {
					"type": "boolean",
					"default": false,
					"description": "%settings.debug.description%"
				},
				"mirror-vs.debugProxy.enabled": {
					"type": "boolean",
					"default": false,
					"description": "%settings.debugProxy.enabled.description%",
					"markdownDescription": "%settings.debugProxy.enabled.description%"
				},
				"mirror-vs.debugProxy.serverUrl": {
					"type": "string",
					"default": "http://127.0.0.1:8888",
					"description": "%settings.debugProxy.serverUrl.description%",
					"markdownDescription": "%settings.debugProxy.serverUrl.description%"
				},
				"mirror-vs.debugProxy.tlsInsecure": {
					"type": "boolean",
					"default": false,
					"description": "%settings.debugProxy.tlsInsecure.description%",
					"markdownDescription": "%settings.debugProxy.tlsInsecure.description%"
				},
				"mirror-vs.autoApproveBrowser": {
					"type": "boolean",
					"default": false,
					"description": "%settings.autoApproveBrowser.description%",
					"markdownDescription": "%settings.autoApproveBrowser.description%"
				}
			}
		}
	},
	"scripts": {
		"lint": "eslint . --ext=ts",
		"check-types": "tsc --noEmit",
		"pretest": "turbo run bundle --cwd ..",
		"test": "vitest run",
		"format": "prettier --write .",
		"bundle": "node esbuild.mjs",
		"vscode:prepublish": "pnpm bundle --production",
		"vsix": "mkdirp ../bin && vsce package --no-dependencies --out ../bin",
		"publish:marketplace": "vsce publish --no-dependencies && ovsx publish --no-dependencies",
		"watch:bundle": "pnpm bundle --watch",
		"watch:tsc": "cd .. && tsc --noEmit --watch --project src/tsconfig.json",
		"clean": "rimraf README.md CHANGELOG.md LICENSE dist logs mock .turbo"
	},
	"dependencies": {
		"@ai-sdk/amazon-bedrock": "^4.0.51",
		"@ai-sdk/baseten": "^1.0.31",
		"@ai-sdk/deepseek": "^2.0.18",
		"@ai-sdk/fireworks": "^2.0.32",
		"@ai-sdk/google": "^3.0.22",
		"@ai-sdk/google-vertex": "^4.0.45",
		"@ai-sdk/mistral": "^3.0.19",
		"@ai-sdk/xai": "^3.0.48",
		"@anthropic-ai/sdk": "^0.37.0",
		"@anthropic-ai/vertex-sdk": "^0.7.0",
		"@aws-sdk/client-bedrock-runtime": "^3.922.0",
		"@aws-sdk/credential-providers": "^3.922.0",
		"@google/genai": "^1.29.1",
		"@lmstudio/sdk": "^1.1.1",
		"@mirror-vs/core": "workspace:^",
		"@mirror-vs/ipc": "workspace:^",
		"@mirror-vs/types": "workspace:^",
		"@mistralai/mistralai": "^1.9.18",
		"@modelcontextprotocol/sdk": "1.12.0",
		"@qdrant/js-client-rest": "^1.14.0",
		"@vscode/codicons": "^0.0.36",
		"@vscode/ripgrep": "^1.17.0",
		"ai-sdk-provider-poe": "2.0.18",
		"async-mutex": "^0.5.0",
		"axios": "^1.12.0",
		"cheerio": "^1.0.0",
		"chokidar": "^4.0.1",
		"clone-deep": "^4.0.1",
		"default-shell": "^2.2.0",
		"delay": "^6.0.0",
		"diff": "^5.2.0",
		"diff-match-patch": "^1.0.5",
		"exceljs": "^4.4.0",
		"fast-deep-equal": "^3.1.3",
		"fast-xml-parser": "^5.0.0",
		"fastest-levenshtein": "^1.0.16",
		"fzf": "^0.5.2",
		"get-folder-size": "^5.0.0",
		"global-agent": "^3.0.0",
		"google-auth-library": "^9.15.1",
		"gray-matter": "^4.0.3",
		"i18next": "^25.0.0",
		"ignore": "^7.0.3",
		"isbinaryfile": "^5.0.2",
		"json-stream-stringify": "^3.1.6",
		"jwt-decode": "^4.0.0",
		"lodash.debounce": "^4.0.8",
		"mammoth": "^1.9.1",
		"monaco-vscode-textmate-theme-converter": "^0.1.7",
		"node-cache": "^5.1.2",
		"node-ipc": "^12.0.0",
		"ollama": "^0.5.17",
		"openai": "^5.12.2",
		"os-name": "^6.0.0",
		"p-limit": "^6.2.0",
