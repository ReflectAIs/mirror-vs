{
	"extends": "@mirror-vs/config-typescript/base.json",
	"compilerOptions": {
		"types": ["vitest/globals"],
		"outDir": "dist",
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"baseUrl": ".",
		"paths": {
			"@/*": ["src/*"],
			"@mirror-vs/types": ["../../packages/types/src/index.ts"],
			"@mirror-vs/core": ["../../packages/core/src/index.ts"],
			"@mirror-vs/core/cli": ["../../packages/core/src/cli.ts"],
			"@mirror-vs/vscode-shim": ["../../packages/vscode-shim/src/index.ts"]
		}
	},

	"include": ["src", "*.config.ts"],
	"exclude": ["node_modules"]
}
