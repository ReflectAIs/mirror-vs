{
	"name": "@mirror-vs/core",
	"description": "Platform agnostic core functionality for Mirror VS.",
	"version": "1.0.4",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js",
			"default": "./dist/index.mjs"
		},
		"./browser": {
			"types": "./dist/browser.d.ts",
			"import": "./dist/browser.mjs",
			"require": "./dist/browser.js",
			"default": "./dist/browser.mjs"
		},
		"./cli": {
			"types": "./dist/cli.d.ts",
			"import": "./dist/cli.mjs",
			"require": "./dist/cli.js",
			"default": "./dist/cli.mjs"
		}
	},
	"scripts": {
		"build": "tsup src/index.ts src/browser.ts src/cli.ts --format esm,cjs --dts --clean --sourcemap --out-dir dist",
		"lint": "eslint src --ext=ts --max-warnings=0",
		"check-types": "tsc --noEmit",
		"test": "vitest run",
		"clean": "rimraf dist .turbo"
	},
	"dependencies": {
		"@mirror-vs/types": "workspace:^",
		"esbuild": "^0.25.0",
		"execa": "^9.5.2",
		"ignore": "^7.0.3",
		"openai": "^5.12.2",
		"zod": "^3.25.61"
	},
	"devDependencies": {
		"@mirror-vs/config-eslint": "workspace:^",
		"@mirror-vs/config-typescript": "workspace:^",
		"@types/node": "^24.1.0",
		"rimraf": "^6.0.1",
		"tsup": "^8.4.0",
		"vitest": "^3.2.3"
	}
}
